{
  "name": "freeze-table",
  "version": "1.1.2",
  "description": "Virtualized React list table \u2014 frozen (pinned) columns, drag to resize/reorder/hide, per-column filters, sortable, keyboard row navigation, sticky totals footer, and a built-in column + freeze toolbar. Themeable with CSS variables, per-slot classNames and replaceable components, or fully unstyled. Built on react-table v7. Zero UI-library dependencies.",
  "keywords": [
    "react",
    "table",
    "datagrid",
    "data-grid",
    "virtualized",
    "virtual-scroll",
    "sticky-columns",
    "frozen-columns",
    "pinned-columns",
    "react-table",
    "list",
    "column-resize",
    "column-reorder",
    "sticky-header",
    "excel-like",
    "erp",
    "theme",
    "theming",
    "dark-mode",
    "css-variables",
    "design-tokens",
    "headless",
    "unstyled"
  ],
  "license": "MIT",
  "author": "abmishra (https://www.npmjs.com/~abmishra)",
  "homepage": "https://github.com/Abhimishra2424/freeze-table#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhimishra2424/freeze-table.git"
  },
  "bugs": {
    "url": "https://github.com/Abhimishra2424/freeze-table/issues"
  },
  "main": "dist/freeze-table.cjs.js",
  "module": "dist/freeze-table.esm.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/freeze-table.esm.js",
      "require": "./dist/freeze-table.cjs.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/freeze-table.css"
  },
  "files": [
    "dist",
    "src",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && rollup -c",
    "prepublishOnly": "npm run build",
    "smoke": "node scripts/smoke.js",
    "golden": "node scripts/golden.js",
    "golden:update": "node scripts/golden.js --update",
    "test:unit": "rollup -c rollup.test.mjs && node scripts/.unit.build.cjs",
    "test:dom": "node scripts/dom.cjs",
    "test": "npm run build && npm run smoke && npm run golden && npm run test:unit && npm run test:dom",
    "demo": "rollup -c rollup.demo.mjs",
    "release": "set -a && . ./.env && set +a && npm publish"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.7",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-table": "^7.8.0",
    "rimraf": "^5.0.5",
    "rollup": "^4.14.0"
  },
  "engines": {
    "node": ">=14"
  }
}
